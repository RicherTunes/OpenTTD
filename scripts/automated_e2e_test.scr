
pause

pp reset
pp on
pp_screenshot e2e_01_passthrough

pp enable night
pp set night_intensity 100
pp set night_blue_shift 80
pp_screenshot e2e_02_night

pp disable night
pp enable vignette
pp_screenshot e2e_03_vignette

pp disable vignette
pp enable crt
pp_screenshot e2e_04_crt

pp disable crt
pp enable tiltshift
pp_screenshot e2e_05_tiltshift

pp disable tiltshift
pp enable fxaa
pp_screenshot e2e_06_fxaa

pp disable fxaa
pp enable grain
pp_screenshot e2e_07_grain

pp disable grain
pp set brightness 25
pp set contrast 130
pp set saturation 140
pp set color_temperature 50
pp_screenshot e2e_08_warm

pp set brightness -15
pp set contrast 80
pp set saturation 70
pp set color_temperature -60
pp_screenshot e2e_09_cool

pp reset
pp on
pp set render_scale 75
pp set upscale_mode 2
pp_screenshot e2e_10_fsr1_75

pp set render_scale 100
pp set upscale_mode 0
pp set sharpening 90
pp_screenshot e2e_11_sharp90

pp set sharpening 0
pp enable vignette
pp enable fxaa
pp enable night
pp_screenshot e2e_12_combined

pp reset
pp on
pp_screenshot e2e_13_restored

echo "E2E test complete - 13 screenshots queued"
